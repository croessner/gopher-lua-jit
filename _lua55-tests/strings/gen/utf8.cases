-- Lua 5.5 utf8 library.
! local minint, maxint = 1 << 63, (1 << 63) - 1
! local u = utf8
! local s = "h\u{E4}\u{DF}\u{20AC}\u{1D11E}"


-- utf8.char
u.char()
u.char(72, 228, 8364, 0x10FFFF)
u.char(0x7F, 0x80, 0x7FF, 0x800, 0xFFFF, 0x10000)
u.char(0x1FFFFF, 0x200000, 0x3FFFFFF, 0x4000000, 0x7FFFFFFF)
u.char(0x80000000)
u.char(-1)
u.char(1.5)
u.char("x")
u.char("65")
u.char(0xD800)
u.char(0)

-- utf8.len
u.len(s)
u.len("")
u.len(s, 2)
u.len(s, 3)
u.len(s, 1, 1)
u.len(s, 1, 2)
u.len(s, -4)
u.len(s, -3)
u.len(s, 20)
u.len(s, 1, 20)
u.len(s, 0)
u.len(s, #s + 1)
u.len(s, #s + 2)
u.len(s, 5, 1)
u.len(s, 1, -1)
u.len(s, 1, -20)
u.len(s, -20)

-- utf8.len: invalid sequences and the lax mode
u.len("\xff")
u.len("a\x80")
u.len("ab\xe4")
u.len("\xed\xa0\x80")
u.len("\xed\xa0\x80", 1, -1, true)
u.len("\xf4\x90\x80\x80")
u.len("\xf4\x90\x80\x80", 1, -1, true)
u.len("\xc0\x80")
u.len("\xc0\x80", 1, -1, true)
u.len("\xe0\x80\x80")
u.len("\xfd\xbf\xbf\xbf\xbf\xbf", 1, -1, true)
u.len("\xfe\xbf\xbf\xbf\xbf\xbf\xbf", 1, -1, true)
u.len("\xff\xbf\xbf\xbf\xbf\xbf\xbf\xbf", 1, -1, true)
u.len("\xf8\x88\x80\x80\x80", 1, -1, true)
u.len("\xf8\x88\x80\x80\x80")
u.len("abc", 1, 2, 3)
u.len(123)
u.len()
u.len("abc", "x")
u.len("abc", 1.5)

-- utf8.codepoint
u.codepoint(s)
u.codepoint(s, 1, -1)
u.codepoint(s, 2)
u.codepoint(s, 3)
u.codepoint(s, 2, 3)
u.codepoint(s, -4)
u.codepoint(s, 0)
u.codepoint(s, 1, 100)
u.codepoint(s, 100)
u.codepoint(s, 5, 1)
u.codepoint("", 1)
u.codepoint("")
u.codepoint("abc", 4)
u.codepoint("abc", 3, 4)
u.codepoint("abc", -1)
u.codepoint("abc", -5)
u.codepoint("abc", -5, 1)
u.codepoint("\xff")
u.codepoint("\xed\xa0\x80")
u.codepoint("\xed\xa0\x80", 1, 1, true)
u.codepoint("\xfd\xbf\xbf\xbf\xbf\xbf", 1, 1, true)
u.codepoint("\xf4\x90\x80\x80", 1, 1, true)
u.codepoint("ä", 1, 2)
u.codepoint("aä", 1, 2)
u.codepoint("aä", 1, 3)
u.codepoint("ä", 1, 1)
u.codepoint("a\xe4", 1, 2)

-- utf8.offset returns the start and the end position of the character
u.offset(s, 1)
u.offset(s, 2)
u.offset(s, 3)
u.offset(s, 5)
u.offset(s, 6)
u.offset(s, 7)
u.offset(s, -1)
u.offset(s, -2)
u.offset(s, -5)
u.offset(s, -6)
u.offset(s, 0)
u.offset(s, 0, 3)
u.offset(s, 0, 2)
u.offset(s, 0, #s)
u.offset(s, 0, #s + 1)
u.offset(s, 0, #s + 2)
u.offset(s, 1, 3)
u.offset(s, 1, 2)
u.offset(s, 2, 2)
u.offset(s, -1, 2)
u.offset(s, -1, 3)
u.offset(s, 1, -4)
u.offset(s, 1, -3)
u.offset(s, 1, 100)
u.offset(s, 1, 0)
u.offset(s, 1, -100)
u.offset("", 1)
u.offset("", 0)
u.offset("", -1)
u.offset("", 2)
u.offset("abc", 4)
u.offset("abc", 5)
u.offset("abc", 1, 4)
u.offset("abc", 0, 4)
u.offset("abc", -1, 4)
u.offset("abc", -3)
u.offset("abc", -4)
u.offset("\x80", 0)
u.offset("\x80", 1)
u.offset("a\x80\x80", 0, 3)
u.offset("a\x80\x80", 2)
u.offset("\x80\x80a", -1)
u.offset("\xe4", 1)
u.offset("\xe4\xbf", 1)
u.offset("abc")
u.offset("abc", 1.5)
u.offset("\x80abc", -3)

! local function codes(str, lax) local t = {} for p, c in u.codes(str, lax) do t[#t + 1] = p .. ":" .. c end return table.concat(t, " ") end

-- utf8.codes
codes(s)
codes("")
codes("abc")
codes("\xff")
codes("a\xff")
codes("a\x80")
codes("\x80a")
codes("ab\xe4")
codes("\xed\xa0\x80")
codes("\xed\xa0\x80", true)
codes("\xf4\x90\x80\x80")
codes("\xf4\x90\x80\x80", true)
codes("\xfd\xbf\xbf\xbf\xbf\xbf", true)
codes("ä\x80")
codes(123)
codes(nil)
codes("\xc3\xa4\xa4")

-- the iterator triple of utf8.codes
! local f, st, c0 = u.codes("a\u{E4}")
type(f), st, c0
f(st, 0)
f(st, 1)
f(st, 2)
f(st, 3)
f(st, 100)
f(st, -1)
f(st)
f(st, "1")
f(st, 1.0)
f()
f("ab", {})
f("ab", 1.5)
f({}, 1)
! local seen = {}
! for p, c in u.codes("\u{7FF}\u{800}\u{FFFF}\u{10000}\u{10FFFF}") do seen[#seen + 1] = p .. "=" .. string.format("%X", c) end
table.concat(seen, " ")

-- utf8.charpattern
u.charpattern, #u.charpattern
! local lens = {}
! for c in ("h\u{E4}\u{DF}\u{20AC}\u{1D11E}x"):gmatch(u.charpattern) do lens[#lens + 1] = #c end
table.concat(lens, " ")
("\u{20AC}"):match("^" .. u.charpattern .. "$") == "\u{20AC}"

-- round trips and extended (lax) code points
u.char(228) == "\u{E4}", u.char(8364) == "\u{20AC}", u.len("\u{E4}"), u.codepoint("\u{20AC}")
u.codepoint(u.char(0, 0x7F, 0x80, 0x7FF, 0x800, 0xFFFF, 0x10000, 0x10FFFF), 1, -1)
u.codepoint(u.char(0x110000, 0x1FFFFF, 0x200000, 0x3FFFFFF, 0x4000000, 0x7FFFFFFF), 1, -1, true)
u.codepoint(u.char(0x110000))
u.codepoint(u.char(0xD800, 0xDFFF), 1, -1, true)
u.len(u.char(0x7FFFFFFF), 1, -1, true), #u.char(0x7FFFFFFF), #u.char(0x3FFFFFF), #u.char(0x1FFFFF)
u.len("\u{7FFFFFFF}"), u.len("\u{7FFFFFFF}", 1, -1, true)
u.len(string.rep("\u{20AC}", 1000)), #string.rep("\u{20AC}", 1000)
u.offset(string.rep("\u{20AC}", 1000), 500), u.offset(string.rep("\u{20AC}", 1000), -500)
! local names = {}
! for k in pairs(utf8) do names[#names + 1] = k end
! table.sort(names)
table.concat(names, " ")
