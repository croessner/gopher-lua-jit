-- Lua 5.5 string.gsub and string.gmatch.
! local minint, maxint = 1 << 63, (1 << 63) - 1

-- string replacement
string.gsub("hello world", "o", "0")
string.gsub("hello world", "o", "0", 1)
string.gsub("hello world", "o", "0", 0)
string.gsub("hello world", "o", "0", -1)
string.gsub("hello world", "o", "0", 100)
string.gsub("hello world", "x", "y")
string.gsub("abc", "", "-")
string.gsub("abc", "", "-", 2)
string.gsub("", "", "-")
string.gsub("", "x", "-")
string.gsub("abc", "a*", "-")
string.gsub("abc", "b*", "-")
string.gsub("abc", ".-", "-")
string.gsub("abc", "%w", "%0%0")
string.gsub("abc", "%w", "%0%0", 2)
string.gsub("abc", "%w", "%%")
string.gsub("abc", "(a)(b)(c)", "%3%2%1%0")
string.gsub("hello world", "(o)(%s?)", "%2%1")
string.gsub("x = 1", "(%w+) = (%w+)", "%2 = %1")
string.gsub("abc", "b", "%1")
string.gsub("abc", "b", "%0")
string.gsub("abc", "b", "%%1")
string.gsub("abc", "b", "[%0]")
string.gsub("abc", "()", "%1")
string.gsub("abc", "()b()", "%1%2")
string.gsub("abc", "(b)", "%1%1%1%1%1%1%1%1%1")
string.gsub("abc", "b", "%2")
string.gsub("abc", "(b)", "%2")
string.gsub("abc", "(a)(b)", "%3")
string.gsub("abc", "b", "%9")
string.gsub("abc", "b", "%x")
string.gsub("abc", "b", "%")
string.gsub("abc", "b", "x%")
string.gsub("abc", "b", "% ")
string.gsub("abc", "x", "%")
string.gsub("abc", "b", 12)
string.gsub("abc", "b", 1.5)
string.gsub("a b c", " ", "", 1)
string.gsub("a\0b", "%z", "0")
string.gsub("a\0b", "\0", "\0\0")
string.gsub("abc", ".", "\0")
string.gsub("hello", "l+", function(s) return #s end)
string.gsub(123, 2, 9)
string.gsub("abc", "b", "x", "1")
string.gsub("abc", "b", "x", 1.0)
string.gsub("abc", "b", "x", 1.5)
string.gsub("abc", "b", "x", {})
string.gsub("abc", "b", "x", nil)
string.gsub("aaa", "a", "b", maxint)
string.gsub("aaa", "a", "b", minint)

-- anchored patterns
string.gsub("abc", "^b", "x")
string.gsub("abc", "^a", "x")
string.gsub("aaa", "^a", "x")
string.gsub("abc", "c$", "x")
string.gsub("abc", "$", "x")
string.gsub("abc", "^", "x")
string.gsub("abc", "^$", "x")
string.gsub("", "^$", "x")
string.gsub("abc", "^.*$", "x")
string.gsub("a^b", "a^", "x")
string.gsub("aaa", "^a", "x", 0)
string.gsub("abc", "^", "x", 5)

-- table replacement
string.gsub("$name is $age", "%$(%w+)", {name = "Bob", age = 42})
string.gsub("abc", ".", {a = 1, b = "B"})
string.gsub("abc", ".", {a = false, b = "X"})
string.gsub("abc", ".", {a = 1.5, b = 2^53, c = -0.0})
string.gsub("abc", "()", {"x", "y"})
string.gsub("abc", "(b)(c)", {b = "first", c = "second"})
string.gsub("abc", "%w", {})
string.gsub("abc", "b", {b = true})
string.gsub("abc", "b", {b = {}})
string.gsub("abc", "b", {b = print})
string.gsub("abc", "%w", setmetatable({}, {__index = function(_, k) return k:upper() end}))
string.gsub("abc", "%w", setmetatable({}, {__index = function(_, k) if k == "b" then return false end return k .. k end}))

-- function replacement
string.gsub("abc def", "%f[%a]%a", string.upper)
string.gsub("abc", "(.)(.)", function(a, b) return b .. a end)
string.gsub("abc", "()", function(p) return p end)
string.gsub("abc", "", function(s) return "[" .. s .. "]" end)
string.gsub("abc d", "%w+", function(w) if w == "d" then return false end return nil end)
string.gsub("abc", "%w", function(c) return c:byte() end)
string.gsub("abc", "%w", function(c) return 1.5 end)
string.gsub("abc", "b", function() return {} end)
string.gsub("abc", "b", function() return true end)
string.gsub("abc", "b", function() end)
string.gsub("abc", "b", function() return "x", "y" end)
string.gsub("abc", "(a)(b)(c)", function(...) return #{...} end)
string.gsub("abc", "b", function(...) return #{...} end)
string.gsub("abc", "(()b())", function(w, p1, p2) return w .. p1 .. p2 end)
string.gsub("abc", "b", function() error("boom", 0) end)
! local seen = {}
! string.gsub("one two  three", "%a+", function(w) seen[#seen + 1] = w end)
table.concat(seen, "|")
string.gsub("hello world", "%w+", "%0 %0", 1)
string.gsub("hello world", "o", {o = "0"}, 1)
string.gsub("hello", "", "-")
string.gsub("héllo", "[\128-\255]+", "?")
string.gsub("  trim  ", "^%s+", "")
string.gsub("  trim  ", "%s+$", "")
string.gsub("a,b,,c", ",", ";")
string.gsub("abc", "b", "%%")
string.gsub("path/to/file", "/", "\\")
string.gsub("x", "x", "%%%%")
string.gsub("abcabc", "(a)(b)(c)", "%1%1")
string.gsub("hello world", "%w+", "<%0>")
string.gsub("abc", "b*", "x")
string.gsub("abc", "b-", "x")
string.gsub("abab", "ab", "")
string.gsub("abc", "(", "x")
string.gsub("abc", "[", "x")
string.gsub("abc", "%", "x")
string.gsub("abc", "b")
string.gsub("abc")
string.gsub()
string.gsub("abc", "b", true)
string.gsub("abc", "b", nil)
string.gsub("abc", "x", true)
string.gsub("abc", {}, "x")
(string.gsub("abc", "x", "y")) == "abc"
(string.gsub(string.rep("ab", 10000), "b", "")) == string.rep("a", 10000)
#{string.gsub(string.rep("ab", 10000), "", "")}, ({string.gsub(string.rep("ab", 10000), "", "")})[2]

-- string.gmatch
! local function collect(...) local t = {} for a, b, c in string.gmatch(...) do t[#t + 1] = tostring(a) .. (b ~= nil and ("=" .. tostring(b)) or "") .. (c ~= nil and ("=" .. tostring(c)) or "") end return table.concat(t, ",") end
collect("a=1, b=2", "(%w+)=(%w+)")
collect("one two", "%a+")
collect("abc", "")
collect("abc", "()")
collect("abc", ".")
collect("abc", "x")
collect("", ".")
collect("", "")
collect("abc", "a*")
collect("abc", "b*")
collect("abc", ".-")
collect("abc abc", "^abc")
collect("x^abc abc", "^abc")
collect("abc", "c$")
collect("abc", "$")
collect("a b c", "%a", 3)
collect("abc def ghi", "%a+", 5)
collect("abc def ghi", "%a+", -3)
collect("abc def ghi", "%a+", 100)
collect("abc def ghi", "%a+", -100)
collect("abc def ghi", "%a+", 0)
collect("abc", "%a*", 4)
collect("abc", "%a*", 5)
collect("abc", "()", 4)
collect("abc", "()", 5)
collect("abc", "()", 3)
collect("k1=v1;k2=v2", "(%w+)=(%w+);?")
collect("abc", "(.)()")
collect("abc", "()(.)()")
collect("hello world from Lua", "%a+", "7")
collect(12345, "%d%d")
collect("abc", "%a", 1.5)
collect("abc", "%a", {})
collect("abc", "(a")
collect("abc", "%")
collect("abc", "[a")
collect("abc")
collect()
collect("abc", nil)
type(string.gmatch("abc", "a")), #{string.gmatch("abc", "a")}
! local it = string.gmatch("ab", "%a")
it(), it(), it(), it()
! local it2 = string.gmatch("a1b2", "(%a)(%d)")
d(it2()) .. "/" .. d(it2()) .. "/" .. d(it2())
! local words = {}
! for w in ("the quick brown fox"):gmatch("%a+") do words[#words + 1] = w end
#words, words[1], words[4]
! local kv = {}
! for k, v in string.gmatch("a=1, b=2, c=3", "(%w+)=(%w+)") do kv[k] = v end
kv.a, kv.b, kv.c
