-- Lua 5.5 string library: len, sub, byte, char, rep, reverse, lower, upper,
-- dump and the string metatable. Generated expectations come from the
-- reference interpreter (lua5.5).
! local minint, maxint = 1 << 63, (1 << 63) - 1

-- string.len
string.len("")
string.len("abc")
string.len("a\0b")
string.len(12)
string.len(1.0)
string.len(1e100)
string.len(-0.0)
string.len()
string.len({})
string.len(nil)
string.len(true)
#"abc", #"", #"\0\0"

-- string.sub
string.sub("hello", 2)
string.sub("hello", 2, 3)
string.sub("hello", -3)
string.sub("hello", -3, -2)
string.sub("hello", 0)
string.sub("hello", 10)
string.sub("hello", 2, 100)
string.sub("hello", -100, 2)
string.sub("hello", 3, 2)
string.sub("hello", 2, -100)
string.sub("hello", minint, maxint)
string.sub("hello", maxint)
string.sub("hello", minint)
string.sub("hello", 1, minint)
string.sub("hello", maxint, minint)
string.sub("hello", 2.0, 3.0)
string.sub("hello", "2", "3")
string.sub("hello", "2.0")
string.sub("hello", 1.5)
string.sub("hello", 1, 2.5)
string.sub("hello", "x")
string.sub("hello")
string.sub()
string.sub("hello", 1, 0)
string.sub("hello", 6)
string.sub("hello", 5)
string.sub("hello", -1)
string.sub("hello", 0, 0)
string.sub("hello", 1, 1)
string.sub("hello", 5, 5)
string.sub("hello", -5, -5)
string.sub("hello", -6, -5)
string.sub(12345, 2, 3)
string.sub(1.5, 2)
string.sub("hello", 2, nil)
string.sub("hello", nil)
string.sub("", 1)
string.sub("", 0, 0)
string.sub("a\0b\0c", 2, 4)

-- string.byte
string.byte("abc")
string.byte("abc", 2)
string.byte("abc", 1, -1)
string.byte("abc", -1)
string.byte("abc", 0)
string.byte("abc", 4)
string.byte("abc", 2, 100)
string.byte("abc", -100, 2)
string.byte("abc", 3, 2)
string.byte("", 1)
string.byte("")
string.byte("\0\255")
string.byte("\0\255", 1, 2)
string.byte("abc", 1.5)
string.byte("abc", 1, 1.5)
string.byte("abc", minint, maxint)
string.byte("abc", maxint)
string.byte("abc", nil, 2)
string.byte("abc", 2, nil)
string.byte("abc", "2")
string.byte("abc", {})
string.byte(65)
string.byte()
#{string.byte(string.rep("x", 100), 1, -1)}

-- string.char
string.char()
string.char(72, 105)
string.char(0, 255)
string.char(256)
string.char(-1)
string.char(65.0)
string.char(65.5)
string.char("65")
string.char("x")
string.char(65, nil)
string.char(1, 2, 300)
string.char(maxint)
string.char(string.byte("round trip", 1, -1))

-- string.rep
string.rep("ab", 3)
string.rep("ab", 0)
string.rep("ab", -1)
string.rep("ab", 1)
string.rep("ab", 3, ", ")
string.rep("ab", 1, ", ")
string.rep("ab", 0, ", ")
string.rep("ab", -5, ", ")
string.rep("", 5)
string.rep("", 5, "-")
string.rep("x", 2.0)
string.rep("x", 2.5)
string.rep("x")
string.rep("x", "3")
string.rep("x", "y")
string.rep(1, 3)
string.rep(1.5, 2, 0)
string.rep("ab", maxint)
string.rep("ab", maxint, "-")
string.rep("", maxint)
string.rep("", maxint, "")
string.rep("x", minint)
string.rep("x", 3, 5)
string.rep("x", 3, {})
string.rep("x", 2, nil)
string.rep({}, 2)
#string.rep("abc", 1000), #string.rep("abc", 1000, "--")
string.rep("a\0", 2, "\0\0")

-- string.reverse
string.reverse("abc")
string.reverse("")
string.reverse("a\0b")
string.reverse(123)
string.reverse()
string.reverse("\255\0\1")

-- string.lower / string.upper only map ASCII letters
string.lower("ABC def ÄÖ")
string.upper("abc DEF äö")
string.lower(12)
string.upper(1.5)
string.upper()
string.lower({})
string.upper("\xe4\xff\0z")
string.lower("")
string.upper("straße")
string.lower("[\\]^_`@{")
string.upper("[\\]^_`@{")

-- string.dump
string.dump(print)
string.dump()
string.dump(1)

-- the string metatable
getmetatable("").__index == string
string.__index
string.gfind
("abc"):len(), ("abc"):upper(), ("%d"):rep(2), ("x"):byte(), ("abc"):sub(2)
("a,b"):find(",", 1, true)
("x"):rep(3, ", ")
("%5.1f|%d"):format(3.14159, 42)
! local s = "method"
s:len(), s:sub(2, 3), s:reverse()
! local names = {}
! for k in pairs(string) do names[#names + 1] = k end
! table.sort(names)
table.concat(names, " ")
