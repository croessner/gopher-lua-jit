-- Lua 5.5 string.format.
! local minint, maxint = 1 << 63, (1 << 63) - 1
! local inf, nan = 1 / 0, 0 / 0

-- literal text and %%
string.format("")
string.format("plain")
string.format("100%%")
string.format("%d%%", 50)
string.format("\0%d\0", 5)
string.format(5)
string.format(1.0)
string.format("%s %s", 1, 2, 3)
string.format()
string.format({})

-- %d and %i
string.format("%d", 0), string.format("%d", -0), string.format("%i", 42), string.format("%d", -42)
string.format("%d", minint), string.format("%d", maxint)
string.format("%5d|%-5d|%05d", 42, 42, 42)
string.format("%5d|%-5d|%05d", -42, -42, -42)
string.format("%+d|% d|%+d|% d", 5, 5, -5, -5)
string.format("% 5d|% -5d|%+-5d|%+05d|% 05d", 3, 3, 3, 3, 3)
string.format("%.3d|%5.3d|%-5.3d|%05.3d|%+.3d", 5, 5, 5, 5, 5)
string.format("%.20d|%20.10d|%-20.10d", 5, -5, 5)
string.format("%.d|%.0d|%.d|%5.d|%5.0d|", 0, 0, 5, 0, 0)
string.format("%5.2i", 3)
string.format("%d", 3.0), string.format("%d", "10"), string.format("%d", "0x10"), string.format("%d", "5.0"), string.format("%d", 2^53)
string.format("%d", 1.5)
string.format("%d", "5.5")
string.format("%d", "x")
string.format("%d", {})
string.format("%d", nil)
string.format("%d")
string.format("%d", 2^63)
string.format("%d", inf)
string.format("%d", nan)
string.format("%d %d", 1)
string.format("%#d", 5)
string.format("%99d|", 7)
string.format("%-99d|", 7)

-- %u
string.format("%u", 3), string.format("%u", -3), string.format("%u", minint), string.format("%5u|%-5u|%05u|%.3u", 1, 2, 3, 4)
string.format("%+u", 3)
string.format("% u", 3)
string.format("%#u", 3)

-- %c
string.format("%c%c%c", 76, 117, 97)
string.format("%5c|%-5c|", 65, 66)
string.format("%c", 0)
string.format("%c", 256 + 65)
string.format("%c", "65")
string.format("%c", 65.0)
string.format("%c", 65.5)
string.format("%.2c", 65)
string.format("%05c", 65)
string.format("%+c", 65)

-- %x, %X and %o
string.format("%x|%X|%o", 255, 255, 8)
string.format("%x|%X|%o", -1, -1, -1)
string.format("%x", minint), string.format("%x", maxint)
string.format("%#x|%#X|%#o", 255, 255, 8)
string.format("%#x|%#X|%#o", 0, 0, 0)
string.format("%#.0o|%#.0x|%.0x|%.0o|", 0, 0, 0, 0)
string.format("%#5x|%#-5x|%#05x|%#.3x|%#08x|%-#8x|", 0, 1, 1, 255, 255, 255)
string.format("%8x|%-8x|%08x|%.4x|%8.4x|%-8.4X|", 255, 255, 255, 255, 255, 255)
string.format("%#o|%#5o|%#.3o|%#.2o|%05o", 8, 8, 8, 8, 8)
string.format("%x", 3.0), string.format("%x", "255")
string.format("%x", 1.5)
string.format("%x", 1e100)
string.format("%+x", 5)
string.format("% x", 5)
string.format("%+o", 5)

-- %e and %E
string.format("%e|%E", 0, 123456)
string.format("%e|%e|%e", 1, -1.5, 12345.678)
string.format("%.0e|%#.0e|%.1e|%.10e", 5, 5, 5, 0.1)
string.format("%.3e|%.3e", 9.9996, 9.9994)
string.format("%+.2e|% .2e|%12.2e|%-12.2e|%012.2e", 12345.678, 12345.678, 12345.678, 12345.678, 12345.678)
string.format("%e|%e|%e", 1e300, 1e-300, 5e-324)
string.format("%.e", 2.5)
string.format("%.99e", 0.1)
string.format("%e", "1e1"), string.format("%e", 3)
string.format("%e", "abc")
string.format("%e", {})

-- %f (there is no %F)
string.format("%f|%f|%f", 0, 1, -1.5)
string.format("%5.1f|%-8.3f|%08.3f|%+.2f|% .2f", 3.14159, 2.5, 2.5, 2.5, 2.5)
string.format("%.0f|%.0f|%.0f|%.0f|%.1f|%.1f", 0.5, 1.5, 2.5, 3.5, 0.25, 0.35)
string.format("%#.0f|%.f|%#.f", 3, 2.5, 2.5)
string.format("%010.2f|%-010.2f|%+010.2f|% 010.2f", -5.5, 5.5, 5.5, 5.5)
string.format("%.3f|%.3f", 2.0005, 1 << 62)
string.format("%.20f", 0.1)
string.format("%.99f", 1 / 3)
string.format("%.20f", 1e100)
string.format("%99.99f", -1e308)
string.format("%f", 5e-324), string.format("%.10f", 1e-10)
string.format("%99.0f|", 1)
string.format("%f", -0.0), string.format("%+f", 0.0), string.format("%.0f", -0.4)
string.format("%F", 1)

-- %g and %G
string.format("%g|%g|%g|%g|%g", 0, 1, -1.5, 100000, 1000000)
string.format("%g|%g|%g|%g|%g", 0.1, 1e300, 1e-300, 123456, 1234567)
string.format("%g|%g|%g|%g", 1e15, 1e16, 123456789, 0.00001234)
string.format("%g|%g|%g|%G|%g", 1e-4, 1e-5, 0.0001234, 1e-5, 1e100)
string.format("%g|%g", -0.0, 5e-324)
string.format("%.3g|%10.3g|%-10.3g|%010.3g|%+.3g|% .3g", 1234.5, 1234.5, 1234.5, 1234.5, 1234.5, 1234.5)
string.format("%#g|%#.3g|%#.3g|%#g|%#.0g|%#.1g", 1, 1e10, 0.0001, 0, 5, 5)
string.format("%.0g|%.1g|%.10g|%.20g|%.g", 0.5, 0.05, 0.1, 0.1, 2.5)
string.format("%.15g|%.16g|%.17g|%.14g", 0.3, 0.3, 0.3, 0.1)
string.format("%.99g", 0.1)
string.format("%g|%g|%g", 99999.95, 999999.5, 9.9999995)
string.format("%.3g|%.3g|%.3g", 999.5, 99.95, 0.00099995)
string.format("%g", 1 << 62), string.format("%g", "0x10"), string.format("%g", 2^63)
string.format("%G|%G", 1e-10, 1e20)

-- infinities and NaN
string.format("%f|%e|%g|%a", inf, inf, inf, inf)
string.format("%f|%e|%g|%a", -inf, -inf, -inf, -inf)
string.format("%f|%e|%g|%a", nan, nan, nan, nan)
string.format("%E|%G|%A", inf, -inf, nan)
string.format("%+f|% f|%+g|% e", inf, inf, -inf, inf)
string.format("%+f|% f|%f", nan, nan, -nan)
string.format("%010f|%10f|%-10f|%05g|%-6e|", inf, -inf, nan, inf, inf)
string.format("%.0f|%.3f|%#f", inf, -inf, nan)

-- %a and %A (hexadecimal floats)
string.format("%a|%A", 1, 0.5)
string.format("%a|%a|%a|%a", 0, -0.0, 3.14, 123456.789)
string.format("%a|%a|%a|%a", 2^-1022, 2^-1030, 5e-324, 1.7976931348623157e308)
string.format("%.3a|%.0a|%.1a|%.5a", 3.14, 3.14, 1.9, 1)
string.format("%.20a|%.13a|%.12a", 1.1, 1.1, 1.1)
string.format("%#.0a|%#a|%#a", 1, 2, 1.5)
string.format("%20a|%-20a|%020a|%+a|% a", 1.5, 1.5, 1.5, 1.5, 1.5)
string.format("%A|%.3A|%#A|%+A", 255.5, 255.5, 2, 2)
string.format("%.0a|%.1a|%.2a", 1.75, 1.03, 1.999)
string.format("%.3a|%.0a", 0, 0)
string.format("%a", "1.5"), string.format("%a", 10)
string.format("%a", "x")

-- %s
string.format("%s %s %s %s", 1, 1.5, nil, true)
string.format("%s|%s|%s", 5.0, -0.0, 1e100)
string.format("%s", minint), string.format("%s", 2^63)
string.format("%.3s|%5s|%-5s|%5.1s", "abcdef", "ab", "ab", "ab")
string.format("%5.3s|%-5.3s|%.0s|%.s|", "abcdef", "abcdef", "abc", "abc")
string.format("%5.2s|%5.20s|%10.4s|", "abc", "abc", "abcdefgh")
string.format("%s", "a\0b")
string.format("%5s", "a\0b")
string.format("%.1s", "a\0b")
string.format("%s", "\0")
string.format("%05s", "ab")
string.format("%+s", "ab")
string.format("%s")
string.format("%d %s", 1)
string.format("%s", string.rep("ab", 100)) == string.rep("ab", 100)
string.format("%10s|", string.rep("ab", 60)) == string.rep("ab", 60) .. "|"
string.format("%-200s|", "x")
string.format("%.5s|%-10.5s|", string.rep("ab", 60), string.rep("ab", 60))
string.format("%99s|", "x")
string.format("%-99s|", "x")
string.format("%.99s|", string.rep("x", 150)) == string.rep("x", 99) .. "|"
string.format("%s", setmetatable({}, {__tostring = function() return "TS" end}))
string.format("%5s|%.1s", setmetatable({}, {__tostring = function() return "TS" end}), setmetatable({}, {__tostring = function() return "TS" end}))
string.format("%s", setmetatable({}, {__tostring = function() return {} end}))
string.format("%.2s", setmetatable({}, {__name = "NM"}))
string.format("%.6s|%.9s", {}, print)
string.format("%s", {}) == string.format("%s", {})

-- %q
string.format("%q", "plain")
string.format("%q", "a\nb\0c\"d\\e\r1\0012\200\t")
string.format("%q", "\0001\0a\1\0019")
string.format("%q", "\200\255é\127")
string.format("%q", "")
string.format("%q", 1), string.format("%q", -5), string.format("%q", maxint)
string.format("%q", minint)
string.format("%q", 1.5), string.format("%q", 1.0), string.format("%q", 0.1), string.format("%q", -0.0), string.format("%q", 2^63)
string.format("%q", 1e100), string.format("%q", -1e-100), string.format("%q", 5e-324)
string.format("%q", inf), string.format("%q", -inf), string.format("%q", nan)
string.format("%q", nil), string.format("%q", true), string.format("%q", false)
string.format("%q", {})
string.format("%q", print)
string.format("%q")
string.format("%5q", "x")
string.format("%.3q", "x")
string.format("%-q", "x")

-- %p
string.format("%p", nil), string.format("%p", true), string.format("%p", 1), string.format("%p", 1.5)
string.format("%10p|%-10p|", nil, false)
! local tbl = {}
string.format("%p", tbl) == string.format("%p", tbl), string.format("%p", tbl) ~= string.format("%p", {})
string.format("%p", print) == string.format("%p", print), string.format("%p", tbl) ~= "(null)"
string.format("%p", "ab") == string.format("%p", "a" .. "b"), string.format("%p", "ab") ~= string.format("%p", "ba")
#string.format("%20p", tbl), #string.format("%-20p", tbl)
string.format("%.3p", tbl)
string.format("%05p", tbl)

-- invalid conversions and specifications
string.format("%y", 1)
string.format("%", 1)
string.format("%d %", 1, 2)
string.format("x%")
string.format("%10", 1)
string.format("%ld", 1)
string.format("%hd", 1)
string.format("%n", 1)
string.format("%5%", 1)
string.format("%5%")
string.format("%-%", 1)
string.format("%1$d", 1)
string.format("%*d", 1, 2)
string.format("%100d", 1)
string.format("%.100d", 1)
string.format("%0100d", 1)
string.format("%-300s", "x")
string.format("%.123f", 1)
string.format("%123.1f", 1)
string.format("%1.2.3f", 1)
string.format("%--5d|%00005d|%-+ 05d|", 1, 2, 3)
string.format("%" .. string.rep("-", 20) .. "d", 1)
string.format("%" .. string.rep("-", 21) .. "d", 1)
string.format("%" .. string.rep("0", 40) .. "d", 1)
string.format("%.3f %5.1f %e", 1, 2, 3)
string.format("%s %d %q %c %x", "a", 1, "b", 67, 255)
