-- Lua 5.5 pattern matching: string.find and string.match.
! local minint, maxint = 1 << 63, (1 << 63) - 1

-- plain searches and init handling of string.find
string.find("hello world", "wor")
string.find("hello world", "o")
string.find("hello world", "o", 6)
string.find("hello world", "o", -4)
string.find("hello world", "xyz")
string.find("abc", "b", 10)
string.find("abc", "", 10)
string.find("abc", "", 5)
string.find("abc", "", 4)
string.find("abc", "", 3)
string.find("abc", "")
string.find("abc", "", -10)
string.find("abc", "", 0)
string.find("abc", "c", -1)
string.find("abc", "a", -1)
string.find("abc", "a", minint)
string.find("abc", "a", maxint)
string.find("", "")
string.find("", "", 1)
string.find("", "", 2)
string.find("", "a")
string.find("a.c", ".", 1, true)
string.find("a.c", "%.", 1, true)
string.find("a%.c", "%.", 1, true)
string.find("a.c", ".", 2, true)
string.find("a.c", ".", 3, true)
string.find("a+b", "+", 1, true)
string.find("a+b", "+")
string.find("abc", "b", nil, true)
string.find("abc", "b", 1, false)
string.find("abc", "[b]", 1, 1)
string.find("abc", "[b]", 1, nil)
string.find("a\0b", "\0")
string.find("a\0b", "b")
string.find("a\0b\0c", "\0c", 1, true)
string.find(12345, 34)
string.find(1.0, "%.")
string.find("abc", "b", "2")
string.find("abc", "b", 2.0)
string.find("abc", "b", 1.5)
string.find("abc", "b", {})
string.find("abc", nil)
string.find("abc")
string.find()
string.find({}, "a")

-- anchors
string.find("abc", "^b")
string.find("abc", "^b", 2)
string.find("abc", "^a")
string.find("abc", "^")
string.find("abc", "$")
string.find("abc", "^$")
string.find("", "^$")
string.find("abc", "b$")
string.find("abc", "c$")
string.find("abc", "^abc$")
string.find("a$c", "a$c")
string.find("a^c", "a^c")
string.find("abc", "^^a")
string.find("^abc", "^^a")
string.find("abc$", "c$$")
string.find("abc", "%$")
string.find("a$", "%$")
string.find("a^", "%^")
string.find("abc", "^", 4)
string.find("abc", "^", 5)
string.find("abc", "$", 4)

-- character classes
string.find("abc123", "%d")
string.find("abc123", "%d+")
string.find("abc123", "%a+")
string.find("abc123", "%D+")
string.find("  x  ", "%S")
string.find("x \t\n\v\f\ry", "%s+")
string.find("Hello", "%u"), string.find("Hello", "%l+")
string.find("a,b", "%p"), string.find("a_b", "%p"), string.find("ab", "%p")
string.find("ab_1", "%w+"), string.find("ab_1", "%W")
string.find("xyz09afAFg", "%x+")
string.find("a\1\127b", "%c+")
string.find(" \t\1abc~\127", "%g+")
string.find(" \t\1", "%g")
string.find("a\0b", "%z")
string.find("a\0b", "%Z+")
string.find("abc", ".")
string.find("\n", ".")
string.find("abc", "...")
string.find("ab", "...")
string.match("abc", "%A*"), string.match("ABC", "%L+"), string.match("a b", "%S+"), string.match("a,b", "%P+")
string.match("a1", "%D"), string.match("zz\n", "%C+"), string.match("09af", "%X*"), string.match("ab", "%U+")
string.match("a_b", "%W"), string.match(" \tab", "%G+")
string.match("abc", "%q"), string.match("aqc", "%q"), string.match("a%c", "%%"), string.match("a.c", "%.")
string.match("héllo", "[\128-\255]+")
string.match("\200\201a", "%a"), string.match("\200\201", "%w"), string.match("\200", "%g"), string.match("\200", "%p")
string.match("\255", "."), string.match("\255", "%A"), string.match("\128", "%C")

-- sets
string.find("abc", "[b]")
string.find("abc", "[^a]")
string.find("abc", "[a-c]+")
string.find("abc", "[c-a]+")
string.find("abc", "[]]")
string.find("a]c", "[]]")
string.find("a]c", "[^]]+")
string.find("a-c", "[a-]+")
string.find("a-c", "[-a]+")
string.find("a-c", "[%-]")
string.find("a^c", "[b^]")
string.find("a^c", "[%^]")
string.find("abc", "[^^]+")
string.find("a.b", "[%a.]+")
string.find("a%b", "[%%]")
string.find("ab12", "[%a%d]+")
string.find("ab12", "[^%a]+")
string.find("a\0b", "[\0]")
string.find("a\0b", "[^\0]+")
string.find("x]y", "[%]]")
string.find("a-z", "[a%-z]+")
string.find("abcxyz", "[a-cx-z]+")
string.find("b", "[a-]")
string.find("[", "[[]")
string.find("a[b", "[^[]+")
string.find("09", "[%d-9]+")
string.find("a-", "[%a-z]+")
string.find("abc", "[a-%%]")
string.find("abc", "[")
string.find("abc", "[a")
string.find("abc", "[^")
string.find("abc", "[]")
string.find("abc", "[^]")
string.find("abc", "[a%")
string.find("abc", "[%")
string.find("abc", "[%a")
string.find("abc", "[a-")
string.find("abc", "%")
string.find("abc", "a%")

-- repetitions
string.match("aaab", "a*")
string.match("baaa", "a*")
string.match("aaab", "a+")
string.match("baaa", "a+")
string.match("aaab", "a-")
string.match("aaab", "a-b")
string.match("aaab", "a?")
string.match("aaab", "a?a?a?a?b")
string.match("abc", "a.-")
string.match("abc", "a.-$")
string.match("abc", "a.*")
string.match("abc", ".-c")
string.match("aXb aYb", "a.-b")
string.match("aXb aYb", "a.*b")
string.match("abc", "x*")
string.match("abc", "x-")
string.match("abc", "x?")
string.match("abc", "x+")
string.match("abc", "[ab]*c")
string.match("aaa", "a-b")
string.match("a+b", "a%+b")
string.match("abc", "*")
string.match("a*c", "a*")
string.match("***", "*+")
string.match("abc", "+")
string.match("a?c", "a?")
string.match("-", "-")
string.match("a-", "a-")
string.match("ab", "a?b?c?")
string.match("0123456789", "%d-5")
string.match("xyz", "%a-()")
string.find("a\nb", "a.b")
string.match(string.rep("a", 1000) .. "b", "a*b") == string.rep("a", 1000) .. "b"
string.match(string.rep("a", 1000) .. "b", "a-b") == string.rep("a", 1000) .. "b"
string.find(string.rep("a", 1000), "a*b")
string.find(string.rep("a", 5000) .. "b", ".-b")

-- captures
string.match("key = value", "(%w+)%s*=%s*(%w+)")
string.match("2024-01-02", "(%d+)-(%d+)-(%d+)")
string.match("abc", "((a)(b))")
string.match("abc", "(a)(b)(c)")
string.match("abc", "()b()")
string.match("abc", "()")
string.match("abc", ".*()")
string.match("abc", "(.-)()")
string.match("abc", "x")
string.match("abc", "(x)")
string.match("abc", "(a*(.)%w(%s*))")
string.match("  trim  ", "^%s*(.-)%s*$")
string.match("0x1F", "^0[xX](%x+)$")
string.match("abc", "()()()")
string.match("hello", "(h)(e)(l)(l)(o)")
string.match("abc", "(b)", 2)
string.match("abc", "(b)", 3)
string.find("abc", "(b)()(c)")
string.find("abc", "()", 2)
string.find("abc", "(a)", 1, true)
string.find("(a)", "(a)", 1, true)
string.find("THE (quick) fox", "%((%a+)%)")
string.match("abc", "(")
string.match("abc", "(a")
string.match("abc", "(a(b)")
string.match("abc", "a)")
string.match("abc", ")")
string.match("abc", "(a))")
string.match("abc", "(()")
string.match("abc", string.rep("(a?)", 32))
string.match("abc", string.rep("(a?)", 33))
string.match("abc", string.rep("()", 32))
string.match("abc", string.rep("()", 33))
string.match("abc", string.rep("(", 32) .. "a" .. string.rep(")", 32))
string.match("abc", string.rep("(", 33) .. "a" .. string.rep(")", 33))

-- back-references
string.match("abab", "(ab)%1")
string.match("abcabc", "(a)(b)(c)%1%2%3")
string.match("hello hello", "(%w+) %1")
string.match("hello world", "(%w+) %1")
string.match("aa", "(a)%1")
string.match("ab", "(a)%1")
string.match("=[[x]]=", "(=*)%[%[(.-)%]%]%1")
string.match("abc", "()%1")
string.match("abc", "(a)%2")
string.match("abc", "(a%1)")
string.match("abc", "%1")
string.match("abc", "%0")
string.match("abc", "(a)%0")
string.match("abc", "(a)(%1)")
string.match("aaa", "(a*)%1")
string.match("abab", "(a)(b)%2?%1")

-- %b
string.match("f(a(b)c)d", "%b()")
string.match("x=[[y]]", "%b[]")
string.match("(()", "%b()")
string.match("())", "%b()")
string.match("abc", "%b()")
string.match("<a<b>>", "%b<>")
string.match("xaax", "%bxx")
string.match("|a|b|", "%b||")
string.match("if x then y end", "%bie")
string.match("((", "%b()")
string.match("a(b)", "%b()$")
string.match("(a)(b)", "(%b())(%b())")
string.match("\0a\1", "%b\0\1")
string.match("abc", "%b")
string.match("abc", "%ba")
string.match("abc", "a%b")
string.match("(x)", "%b()x")

-- %f
string.find("THE (quick) fox", "%f[%a]%a+", 5)
string.match("abc", "%f[%w]%w+%f[%W]")
string.match("hello world", "%f[%w]w%w*")
string.find("hello world", "%f[%s]")
string.find("hello world", "%f[%S]", 2)
string.find("abc", "%f[%a]")
string.find("abc", "%f[%A]")
string.find("abc", "%f[^%a]")
string.find(" abc", "%f[%a]")
string.find("abc", "%f[\0]")
string.find("abc", "%f[%z]")
string.find("", "%f[\0]")
string.find("", "%f[%a]")
string.find("aaa", "%f[a]a", 2)
string.find("THE END", "%f[%l]")
string.find("abc", "%f")
string.find("abc", "%fa")
string.find("abc", "%f[a")
string.find("abc", "%f[")
string.find("foo.bar", "%f[%.]")
string.find("a b", "%f[%a]b")

-- string.match init handling
string.match("abc", "b", 3)
string.match("abc", "b", -2)
string.match("abc", ".", 10)
string.match("abc", "", 4)
string.match("abc", "", 5)
string.match("abc", "()", 4)
string.match("abc", ".", 0)
string.match("abc", ".", -1)
string.match("abc", ".", -100)
string.match("abc", "^b", 2)
string.match("abc", "^(b)(c)$", 2)
string.match(123, "%d", 2)
string.match("abc", "b", 1.5)
string.match("abc")
string.match()

-- limits: the matcher reports patterns that are too complex as an error
string.find(string.rep("a", 300), string.rep("a?", 300))
string.find(string.rep("a", 199), string.rep("a?", 199))
string.find(string.rep("a", 201), string.rep("a?", 201))
string.find(string.rep("x", 60), ".-.-.-y")
#string.match(string.rep("ab", 50000), "^[ab]*$")
#string.match(string.rep("ab", 50000), "^.-$")
